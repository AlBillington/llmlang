    "llmlang.extractor.test_comments_by_node": {
      "file": "llmlang/extractor.py",
      "text": "+ collects llm-test comments by canonical node name\naccepts one or more root paths\nscans source-like text files under the root paths for llm-test handles\nrecords each llm-test comment's canonical node, exact explanation text, relative path, source line, and backing test code\nreturns a mapping of canonical node name to linked test comment records",
      "text_hash": "e95b81b2ad50c83236d2c2e96feae4996d51fb52766584b082adb91434adfb7f",
      "code_hash": "c261257f3b95803cb4f10ca2113cad3345e0d0fae2857f55dafa5118f38b5a10",
      "last_change": {
        "disposition": "unrelated ripple: renamed the Compiler package to llmlang (matching standard Python packaging convention - the importable package now matches the pip distribution name), with each module file renamed to snake_case (Parser.py -> parser.py, LockfileBuilder.py -> lockfile_builder.py, etc.). Tracking key changed because it's built from the folder/file path; no behavior changed.",
        "for_spec_hash": "e95b81b2ad50c83236d2c2e96feae4996d51fb52766584b082adb91434adfb7f",
        "for_code_hash": "c261257f3b95803cb4f10ca2113cad3345e0d0fae2857f55dafa5118f38b5a10"
      }
    },
    "llmlang.lockfile_builder.build": {
      "file": "llmlang/lockfile_builder.py",
      "text": "+ builds a lockfile by using Parser to read llmlang, Extractor to locate each entry's code, and Lockfile to record a text and code hash per entry\naccepts an llmlang file path and a lockfile output path\nbuilds a lockfile by using Parser to read llmlang, Extractor to locate each source-handled entry's code, and Lockfile to record a text and code hash per entry\nwrites test trace records with the llm-test explanation text, relative path, and backing code hash\nrefuses to write the lockfile when any test bullet lacks a matching llm-test comment or any llm-test comment lacks a matching test bullet\nhas no notion of dispositions or a change manifest at all; never reads or writes anything but the lockfile itself\nshould reproduce the same hashes when run again against an unchanged codebase\nreturns the built lock data",
      "text_hash": "e1461a1fa6d2acf40cb3894662ebca547b9e78f72a94931b6f8a180ca4b952f8",
      "code_hash": "32511fb95941aaa6ca8c3b65e16fdcddbf6a72288e29a4f0364ec4cd71aa1eba",
      "last_change": {
        "disposition": "unrelated ripple: renamed the Compiler package to llmlang (matching standard Python packaging convention - the importable package now matches the pip distribution name), with each module file renamed to snake_case (Parser.py -> parser.py, LockfileBuilder.py -> lockfile_builder.py, etc.). Tracking key changed because it's built from the folder/file path; no behavior changed.",
        "for_spec_hash": "e1461a1fa6d2acf40cb3894662ebca547b9e78f72a94931b6f8a180ca4b952f8",
        "for_code_hash": "32511fb95941aaa6ca8c3b65e16fdcddbf6a72288e29a4f0364ec4cd71aa1eba"
      }
    },
    "llmlang.lockfile_builder.finalize": {
      "file": "llmlang/lockfile_builder.py",
      "text": "+ guards an incremental rebuild against silently skipping a flagged entry, reading and updating a change manifest bound to the exact spec and code hashes it describes\naccepts an llmlang file path, a lockfile output path, and a change manifest file path\nuses Checker to find every named entry currently flagged against the existing lockfile, and refuses to write anything unless the change manifest covers every one of them with a non-empty disposition\naccepts a fresh disposition in the manifest as a plain string, and stamps it with the entry's current spec hash and code hash\na spec hash combines the entry's own text with every policy currently covering it, so a disposition goes stale whether the entry's own text changed or an applicable policy did\nfor a manifest entry that's already stamped, keeps it only if both hashes still match the entry's current state; otherwise drops it as stale, along with any entry whose key no longer exists in the llmlang tree at all\nbuilds every hash and disposition fresh from the current llmlang text, current code, current policies, and current manifest only; never carries anything forward from the lockfile's own prior content\nwrites both the new lockfile and the updated (stamped and pruned) manifest file, but never alters a disposition's own text\nreturns the built lock data",
      "text_hash": "a2ae9afba0e5e4aeb1babdf4611893990774fd787fa86d8dca3e8718f2689e6f",
      "code_hash": "16143a5b0b82e3c4ba654d9735ca28f2031f2a0699cc12562625862a61a9ca4a",
      "last_change": {
        "disposition": "unrelated ripple: renamed the Compiler package to llmlang (matching standard Python packaging convention - the importable package now matches the pip distribution name), with each module file renamed to snake_case (Parser.py -> parser.py, LockfileBuilder.py -> lockfile_builder.py, etc.). Tracking key changed because it's built from the folder/file path; no behavior changed.",
        "for_spec_hash": "a2ae9afba0e5e4aeb1babdf4611893990774fd787fa86d8dca3e8718f2689e6f",
        "for_code_hash": "16143a5b0b82e3c4ba654d9735ca28f2031f2a0699cc12562625862a61a9ca4a"
      }
    },
    "llmlang.coverage_checker.check_coverage": {
      "file": "llmlang/coverage_checker.py",
      "text": "+ checks every module- and class-level Python function against comment handles and inline llm-exempt markers, reporting each uncovered one as UNMAPPED_CODE\naccepts an llmlang file path\nchecks every module- and class-level Python function against comment handles and inline llm-exempt markers, reporting each uncovered one as UNMAPPED_CODE\nonly checks files with a Python extension; files in other languages are silently skipped, not flagged\na function is covered if a comment handle sits on the line directly above it, or above its first decorator\na function nested inside another function is never checked on its own; it has no stable qualified name to report or exempt, and its enclosing function's own handle (if any) already sweeps its code into that handle's region\na function is exempt if a bare \"[llm-exempt]\" comment sits on the line directly above it, or above its first decorator - a reason may be written before the tag on the same line but isn't required, and there is no built-in exemption for dunder methods, private helpers, or anything else\nreturns the list of findings, each a Finding record",
      "text_hash": "fce995bc4afb7df1e534e3449ba1e5dddfa30bc6e66917a2869b74e7676f7cbc",
      "code_hash": "6f50f5b8a4bc58f99ac84ca6e6b9a992ae653c5db5f515164e565212f538fe76",
      "last_change": {
        "disposition": "unrelated ripple: renamed the Compiler package to llmlang (matching standard Python packaging convention - the importable package now matches the pip distribution name), with each module file renamed to snake_case (Parser.py -> parser.py, LockfileBuilder.py -> lockfile_builder.py, etc.). Tracking key changed because it's built from the folder/file path; no behavior changed.",
        "for_spec_hash": "fce995bc4afb7df1e534e3449ba1e5dddfa30bc6e66917a2869b74e7676f7cbc",
        "for_code_hash": "6f50f5b8a4bc58f99ac84ca6e6b9a992ae653c5db5f515164e565212f538fe76"
      }
    },
    "llmlang.lockfile_checker.check": {
      "file": "llmlang/lockfile_checker.py",
      "text": "+ checks a lockfile by using Parser and Extractor to compare current text and code hashes against Lockfile, reporting each entry as SPEC_DIVERGED, CODE_DIVERGED, or unchanged, alongside its file and line\naccepts an llmlang file path and a lockfile path\nchecks a lockfile by using Parser and Extractor to compare current text and code hashes against Lockfile, reporting each entry as SPEC_DIVERGED, CODE_DIVERGED, or unchanged, alongside its file and line\nreports TEST_LINK_MISSING when any test bullet lacks a matching llm-test comment with the same text and canonical node name\nreports TEST_TRACE_STALE when any llm-test comment lacks a matching test bullet with the same text and canonical node name\nreports TEST_CODE_DIVERGED when a linked test's backing code hash differs from the lockfile\nshould report an entry as SPEC_DIVERGED when its own llmlang text changed, it's brand new, or an upstream policy covering it changed\nshould report an entry as CODE_DIVERGED when its handle is missing from the code or its code changed unexpectedly\nshould report an unmodified codebase as fully clean\nnever prints anything itself; every finding is returned as a Finding record in a list, so a caller can present every failure from a run together instead of relying on interleaved prints, or render them as structured data instead of text\neach finding names a file and line where known: entry-level findings point at the entry's header line in the llmlang file, code-level findings point at the handle's own comment line in the source file\nreturns whether everything checked out clean, the set of named-entry tracking keys currently flagged for any reason, and the list of findings",
      "text_hash": "f31b3fd5d36ee28a9552bed3bb5c0b8140d608cf3edfae73b42b1d9da0ec4363",
      "code_hash": "0255708e78b57fe862ce348bd1d703dd140cc9222df46a19be8fcf89321e14e7",
      "last_change": {
        "disposition": "unrelated ripple: renamed the Compiler package to llmlang (matching standard Python packaging convention - the importable package now matches the pip distribution name), with each module file renamed to snake_case (Parser.py -> parser.py, LockfileBuilder.py -> lockfile_builder.py, etc.). Tracking key changed because it's built from the folder/file path; no behavior changed.",
        "for_spec_hash": "f31b3fd5d36ee28a9552bed3bb5c0b8140d608cf3edfae73b42b1d9da0ec4363",
        "for_code_hash": "0255708e78b57fe862ce348bd1d703dd140cc9222df46a19be8fcf89321e14e7"
      }
    }
  },
  "class_bullets": {},
  "test_traces": {}
}