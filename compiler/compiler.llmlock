    "llmlang.cli.print_report_json": {
      "file": "llmlang/cli.py",
      "text": "+ prints every finding as JSON, structured identically to what the text report renders from\naccepts every checked file's findings, keyed by file\nprints every finding as JSON, structured identically to what the text report renders from\nthe JSON shape is {\"ok\": bool, \"results\": {file: [{category, message, file, line}, ...]}}",
