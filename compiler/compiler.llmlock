    "llmlang.cli.run_finalize": {
      "file": "llmlang/cli.py",
      "text": "+ finalizes exactly one llmlang file's lockfile and change manifest, guarded by Checker\naccepts a single llmlang file path\nfinalizes exactly one llmlang file's lockfile and change manifest, guarded by Checker\nrefuses more than one file argument, since finalize is always scoped to one project\nexits 1 and prints the error on failure",
