    "llmlang.cli.discover_llm_files": {
      "file": "llmlang/cli.py",
      "text": "+ finds every *.llm file under a directory, honoring the built-in and config-configured exclusions\naccepts a root directory and an extra set of directory names to exclude\nfinds every *.llm file under a directory, honoring the built-in and config-configured exclusions\nexcludes .git, __pycache__, node_modules, venv, and .venv by default, plus anything the config's exclude list adds\nreturns the sorted list of discovered files",
