    "llmlang.parser.parse": {
      "file": "llmlang/parser.py",
      "text": "+ parses a tab-indented llmlang file into a tree of folders, files, classes, and entries\naccepts a file path\nparses a tab-indented llmlang file into a tree of folders, files, classes, named entries, and data entries\na source-handled entry header must include a parenthesized summary after the identifier and before the colon\na data entry header must include the data marker after the identifier and before the parenthesized summary\na nested regular bullet belongs to the same nearest entry, file or class bullet group, or policy item as its parent\na test bullet can live under a named entry, file, or class node\na header's real name is always its first word; any words after a folder, file, or class name up to the colon are a freetext hint, discarded once the name is extracted\nrecords the source line number of each folder, file, class, named entry, and data entry header, and of each test bullet\nreturns the parsed tree",
      "text_hash": "9a98858def2a139268c1793698fc3f22b318fa0e622a2155a0c26c8d19656322",
      "code_hash": "d88810d703486a29a73db5cd0cba55e5ab5e508a646a5ef3f34ed14ac1f994f4",
      "last_change": {
        "disposition": "unrelated ripple: renamed the Compiler package to llmlang (matching standard Python packaging convention - the importable package now matches the pip distribution name), with each module file renamed to snake_case (Parser.py -> parser.py, LockfileBuilder.py -> lockfile_builder.py, etc.). Tracking key changed because it's built from the folder/file path; no behavior changed.",
        "for_spec_hash": "9a98858def2a139268c1793698fc3f22b318fa0e622a2155a0c26c8d19656322",
        "for_code_hash": "d88810d703486a29a73db5cd0cba55e5ab5e508a646a5ef3f34ed14ac1f994f4"
      }
    },
    "llmlang.extractor.TestComment": {
      "file": "llmlang/extractor.py",
      "text": "+ stores a linked llm-test comment and the backing code it anchors\nstores a linked llm-test comment's canonical node, explanation text, relative path, source line, and backing code\nexposes a code hash derived from the backing code",
      "text_hash": "20d5152dab70806917f28be31a0954855463ca98f78bef00159892c8c28c2ec5",
      "code_hash": "bb0d62379359f5992eef51dd16f666e25afdf22208176cc7add48059cd17aba4",
      "last_change": {
        "disposition": "unrelated ripple: renamed the Compiler package to llmlang (matching standard Python packaging convention - the importable package now matches the pip distribution name), with each module file renamed to snake_case (Parser.py -> parser.py, LockfileBuilder.py -> lockfile_builder.py, etc.). Tracking key changed because it's built from the folder/file path; no behavior changed.",
        "for_spec_hash": "20d5152dab70806917f28be31a0954855463ca98f78bef00159892c8c28c2ec5",
        "for_code_hash": "bb0d62379359f5992eef51dd16f666e25afdf22208176cc7add48059cd17aba4"
      }
    },
    "llmlang.extractor.extract_by_handle": {
      "file": "llmlang/extractor.py",
      "text": "+ extracts the code implementing an entry by locating its comment handle and taking everything from the handle's own comment line up to the next handle\naccepts a file path and canonical entry name\nextracts the code implementing an entry by locating its comment handle and taking everything from the handle's own comment line up to the next handle\nincluding the comment line itself means the entry's summary comment is part of the resulting hash, so it can't drift from the llmlang summary undetected\nreturns the extracted code and the line number of its handle comment, or nothing if the handle isn't found",
      "text_hash": "8452197c555ea937c30520b03ce03b84a7bd8b0c2916b7b36517f2657cdc4f33",
      "code_hash": "dfcdba4cfc149411d59081171b439737e81d27a2a6de0cb8e103dbb1d36e12b8",
      "last_change": {
        "disposition": "unrelated ripple: renamed the Compiler package to llmlang (matching standard Python packaging convention - the importable package now matches the pip distribution name), with each module file renamed to snake_case (Parser.py -> parser.py, LockfileBuilder.py -> lockfile_builder.py, etc.). Tracking key changed because it's built from the folder/file path; no behavior changed.",
        "for_spec_hash": "8452197c555ea937c30520b03ce03b84a7bd8b0c2916b7b36517f2657cdc4f33",
        "for_code_hash": "dfcdba4cfc149411d59081171b439737e81d27a2a6de0cb8e103dbb1d36e12b8"
      }
    },
    "llmlang.extractor.handle_line_numbers": {
      "file": "llmlang/extractor.py",
      "text": "+ finds the source line of every comment handle in a file, for coverage checking\naccepts a file path\nfinds the source line of every comment handle in a file, for coverage checking\nreturns the set of line numbers",
      "text_hash": "cfd49872979966b7290a3230865f3eb77ba8da0878632708786d170762be7514",
      "code_hash": "a8a0c66867dfcd947939f1fcb294d6dcf4c7ba9f023eee420eed15d64cb29162",
      "last_change": {
        "disposition": "unrelated ripple: renamed the Compiler package to llmlang (matching standard Python packaging convention - the importable package now matches the pip distribution name), with each module file renamed to snake_case (Parser.py -> parser.py, LockfileBuilder.py -> lockfile_builder.py, etc.). Tracking key changed because it's built from the folder/file path; no behavior changed.",
        "for_spec_hash": "cfd49872979966b7290a3230865f3eb77ba8da0878632708786d170762be7514",
        "for_code_hash": "a8a0c66867dfcd947939f1fcb294d6dcf4c7ba9f023eee420eed15d64cb29162"
      }
    },
    "llmlang.extractor.test_comment_roots": {
      "file": "llmlang/extractor.py",
      "text": "+ chooses where llm-test comments are scanned\naccepts an llmlang file path\nreturns the llmlang file directory and the repository tests directory when a repository root is found",
      "text_hash": "555eff9210bda9dbfdca0093fd62ad021685bc5bb139635b3e2759a17dbd05d1",
      "code_hash": "a5f8d3e17803833fdb889815cca435072ced6f724a6d9f7e84250b8ef53d28a6",
      "last_change": {
        "disposition": "unrelated ripple: renamed the Compiler package to llmlang (matching standard Python packaging convention - the importable package now matches the pip distribution name), with each module file renamed to snake_case (Parser.py -> parser.py, LockfileBuilder.py -> lockfile_builder.py, etc.). Tracking key changed because it's built from the folder/file path; no behavior changed.",
        "for_spec_hash": "555eff9210bda9dbfdca0093fd62ad021685bc5bb139635b3e2759a17dbd05d1",
        "for_code_hash": "a5f8d3e17803833fdb889815cca435072ced6f724a6d9f7e84250b8ef53d28a6"
      }
    },
    "llmlang.extractor.test_comment_base": {
      "file": "llmlang/extractor.py",
      "text": "+ chooses the stable base path for test trace paths\naccepts an llmlang file path\nreturns the repository root when one is found, otherwise the llmlang file directory",
      "text_hash": "036a14bad4f6f52675b6e1fd6f661121e5f761196c3f673ff68c3f2d1d18d7e1",
      "code_hash": "d793db1688af8a0ed0bb89e3a7ab548f643da46f32e700ade39ae1bd4c13cc40",
      "last_change": {
        "disposition": "unrelated ripple: renamed the Compiler package to llmlang (matching standard Python packaging convention - the importable package now matches the pip distribution name), with each module file renamed to snake_case (Parser.py -> parser.py, LockfileBuilder.py -> lockfile_builder.py, etc.). Tracking key changed because it's built from the folder/file path; no behavior changed.",
        "for_spec_hash": "036a14bad4f6f52675b6e1fd6f661121e5f761196c3f673ff68c3f2d1d18d7e1",
        "for_code_hash": "d793db1688af8a0ed0bb89e3a7ab548f643da46f32e700ade39ae1bd4c13cc40"
      }
