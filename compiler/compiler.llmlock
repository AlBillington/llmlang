{
  "lockfile_schema_version": 5,
  "ruleset_version": "2026-08-21-flow-ref-triples",
  "policies": {},
  "entries": {
    "llmlang.lockfile.LockEntry": {
      "file": "llmlang/lockfile.py",
      "text": "+ stores, per source-handled entry, its file, text hash, and code hash\nstores, per source-handled entry, its file, text hash, and code hash\nmay also store a last-change disposition, bound to the entry's spec hash (its own text combined with every currently applicable policy's text) and code hash it was recorded against",
      "text_hash": "95f5b971fdc8b3d65888be804121d90e9437ec153f98bd013a71c009d5ce5c38",
      "code_hash": "8b6f67e1b5389c40fbd5ab5c7c7d712d2ed15763c3c573e79779623c7a80085e"
    },
    "llmlang.lockfile.TestTrace": {
      "file": "llmlang/lockfile.py",
      "text": "+ stores, per linked test comment, the explanation text and backing code hash\nstores, per linked test comment, the explanation text, relative path, and backing code hash",
      "text_hash": "92fb8019738001b932631290f55fe676729bd0d531afb6b9378dfe8b1734c9ef",
      "code_hash": "edd2e7db796eeea2c7699b48f12186b0afffb77f0da55d05d2a5b4e1231b59fb"
    },
    "llmlang.lockfile.Finding": {
      "file": "llmlang/lockfile.py",
      "text": "+ stores one check/coverage failure as structured data, not just display text\ncategory: text (\"CODE_DIVERGED\"): a fixed, stable identifier for the kind of failure, decoupled from the human-readable message's exact wording\nmessage: text (\"the code changed with no matching llmlang update - investigate before assuming it was intentional\"): the full human-readable explanation, identical to what was printed before this existed\nfile: text (\"legacy_app/notes.py\") or nothing: the file the failure is about, when known\nline: number (12) or nothing: the line within that file, when known",
      "text_hash": "1a1b6fb664f66c038a6013ef840c5774b1495b855e7df339b46c1ae9722c5e90",
      "code_hash": "927de630cc8f3b58e7cd7baf1577212d1ee00c4a185d803cfc745b2deab82a29"
    },
    "llmlang.lockfile.FlowRef": {
      "file": "llmlang/lockfile.py",
      "text": "+ stores, per flow reference, the connected llmlang entry hash, code hash, and flow-block hash\ntext: sibling flow file path\ntext: canonical llmlang entry referenced by the flow\n[text]: call names used for that entry in the flow file\ntext: hash of the current llmlang entry text and applicable policies\ntext: hash of the current backing code\ntext: hash of the flow call block text for this entry",
      "text_hash": "6855ad10a7edf751219bd183273f8099c65555ca7ef21fed997ac4e2dc9ec623",
      "code_hash": "5d0d90f7ef8e73164588bfb54d2b25e8861ef58fa774d56ab6205d61ecd9c0de"
    },
    "llmlang.lockfile.LOCKFILE_SCHEMA_VERSION": {
      "file": "llmlang/lockfile.py",
      "text": "+ the lockfile's own schema version, bumped whenever its shape changes\nthe lockfile's own schema version, bumped whenever its shape changes",
      "text_hash": "b9f92471aa22fd03ab91f3b557549276034892eb0e1f302621a907dde3363810",
      "code_hash": "aab7ec74852c633688d1967c9e656a4d98b15dc2627ae1c4b52ede87424dd51f"
    },
    "llmlang.lockfile.RULESET_VERSION": {
      "file": "llmlang/lockfile.py",
      "text": "+ the ruleset version every entry in a lockfile is built under together\nthe ruleset version every entry in a lockfile is built under together",
      "text_hash": "e601f7998dd91fd4a4749025f2de0e57027e38c9c95c0c412f4fb5df430aacda",
      "code_hash": "dd88ff305e92f12b6a76c2d65187a083ca9fc8892e145add25198c6c4b0b0d73"
    },
    "llmlang.parser.parse": {
      "file": "llmlang/parser.py",
      "text": "+ parses a tab-indented llmlang file into a tree of folders, files, classes, and entries\naccepts a file path\nparses a tab-indented llmlang file into a tree of folders, files, classes, named entries, and data entries\na source-handled entry header must include a parenthesized summary after the identifier and before the colon\na data entry header must include the data marker after the identifier and before the parenthesized summary\na nested regular bullet belongs to the same nearest entry, file or class bullet group, or policy item as its parent\na test bullet can live under a named entry, file, or class node\na header's real name is always its first word; any words after a folder, file, or class name up to the colon are a freetext hint, discarded once the name is extracted\nrecords the source line number of each folder, file, class, named entry, and data entry header, and of each test bullet\nreturns the parsed tree",
      "text_hash": "9a98858def2a139268c1793698fc3f22b318fa0e622a2155a0c26c8d19656322",
      "code_hash": "d88810d703486a29a73db5cd0cba55e5ab5e508a646a5ef3f34ed14ac1f994f4"
    },
    "llmlang.extractor.TestComment": {
      "file": "llmlang/extractor.py",
      "text": "+ stores a linked llm-test comment and the backing code it anchors\nstores a linked llm-test comment's canonical node, explanation text, relative path, source line, and backing code\nexposes a code hash derived from the backing code",
      "text_hash": "20d5152dab70806917f28be31a0954855463ca98f78bef00159892c8c28c2ec5",
      "code_hash": "bb0d62379359f5992eef51dd16f666e25afdf22208176cc7add48059cd17aba4"
    },
    "llmlang.extractor.extract_by_handle": {
      "file": "llmlang/extractor.py",
      "text": "+ extracts the code implementing an entry by locating its comment handle and taking everything from the handle's own comment line up to the next handle\naccepts a file path and canonical entry name\nextracts the code implementing an entry by locating its comment handle and taking everything from the handle's own comment line up to the next handle\nincluding the comment line itself means the entry's summary comment is part of the resulting hash, so it can't drift from the llmlang summary undetected\nreturns the extracted code and the line number of its handle comment, or nothing if the handle isn't found",
      "text_hash": "8452197c555ea937c30520b03ce03b84a7bd8b0c2916b7b36517f2657cdc4f33",
      "code_hash": "dfcdba4cfc149411d59081171b439737e81d27a2a6de0cb8e103dbb1d36e12b8"
    },
    "llmlang.extractor.handle_line_numbers": {
      "file": "llmlang/extractor.py",
      "text": "+ finds the source line of every comment handle in a file, for coverage checking\naccepts a file path\nfinds the source line of every comment handle in a file, for coverage checking\nreturns the set of line numbers",
      "text_hash": "cfd49872979966b7290a3230865f3eb77ba8da0878632708786d170762be7514",
      "code_hash": "a8a0c66867dfcd947939f1fcb294d6dcf4c7ba9f023eee420eed15d64cb29162"
    },
    "llmlang.extractor.test_comment_roots": {
      "file": "llmlang/extractor.py",
      "text": "+ chooses where llm-test comments are scanned\naccepts an llmlang file path\nreturns the llmlang file directory and the repository tests directory when a repository root is found",
      "text_hash": "555eff9210bda9dbfdca0093fd62ad021685bc5bb139635b3e2759a17dbd05d1",
      "code_hash": "a5f8d3e17803833fdb889815cca435072ced6f724a6d9f7e84250b8ef53d28a6"
    },
    "llmlang.extractor.test_comment_base": {
      "file": "llmlang/extractor.py",
      "text": "+ chooses the stable base path for test trace paths\naccepts an llmlang file path\nreturns the repository root when one is found, otherwise the llmlang file directory",
      "text_hash": "036a14bad4f6f52675b6e1fd6f661121e5f761196c3f673ff68c3f2d1d18d7e1",
      "code_hash": "d793db1688af8a0ed0bb89e3a7ab548f643da46f32e700ade39ae1bd4c13cc40"
    },
    "llmlang.extractor.test_comments_by_node": {
      "file": "llmlang/extractor.py",
      "text": "+ collects llm-test comments by canonical node name\naccepts one or more root paths\nscans source-like text files under the root paths for llm-test handles\nrecords each llm-test comment's canonical node, exact explanation text, relative path, source line, and backing test code\nreturns a mapping of canonical node name to linked test comment records",
      "text_hash": "e95b81b2ad50c83236d2c2e96feae4996d51fb52766584b082adb91434adfb7f",
      "code_hash": "c261257f3b95803cb4f10ca2113cad3345e0d0fae2857f55dafa5118f38b5a10"
    },
    "llmlang.flow.flow_refs": {
      "file": "llmlang/flow.py",
      "text": "+ returns hash records for internal function references in the sibling flow file\naccepts an llmlang file path and current entry hash records\nreads the sibling `.llmflow` file when one exists\nresolves internal `call` targets to known llmlang entries by exact name or unique suffix match\ntreats `call ... via ...` targets as external calls that are not locked to source handles\nreports each unresolved or ambiguous non-external call target as an error record with its source line, rather than rejecting the whole file\ncombines every call block for the same internal entry into one flow reference hash\nreturns flow reference records keyed by flow file and canonical llmlang entry, together with the list of any call-target errors found",
      "text_hash": "01012dfa3895f5c24ed1dbffc58ece3cf70facc125c297afcf624afa92c9e0fb",
      "code_hash": "c22a79a7384af3d4b7fb3870dfdf651889922479f87c9baca6f81e09d43c860f",
      "last_change": {
        "disposition": "fixed a crash: an unresolved or ambiguous flow call target used to raise a bare ValueError out of flow_refs, which check_one() caught into a list of plain strings instead of Finding objects, and print_report_text/print_report_json both crashed trying to read .message/serialize it - collapsing the whole file's report into an unhandled exception on any single bad flow reference. flow_refs now returns (refs, errors) instead of raising: resolvable call targets are still returned, and each unresolved/ambiguous target becomes a structured error record with its 1-based source line, letting the caller decide how to report it.",
        "for_spec_hash": "01012dfa3895f5c24ed1dbffc58ece3cf70facc125c297afcf624afa92c9e0fb",
        "for_code_hash": "c22a79a7384af3d4b7fb3870dfdf651889922479f87c9baca6f81e09d43c860f"
      }
    },
    "llmlang.lockfile_builder.build": {
      "file": "llmlang/lockfile_builder.py",
      "text": "+ builds a lockfile by using Parser to read llmlang, Extractor to locate each entry's code, and Lockfile to record a text and code hash per entry\naccepts an llmlang file path and a lockfile output path\nbuilds a lockfile by using Parser to read llmlang, Extractor to locate each source-handled entry's code, and Lockfile to record a text and code hash per entry\nwrites test trace records with the llm-test explanation text, relative path, and backing code hash\nwrites flow reference records for internal calls in the sibling flow file\nrefuses to write the lockfile when any test bullet lacks a matching llm-test comment or any llm-test comment lacks a matching test bullet\nrefuses to write the lockfile when any internal flow call target is unresolved or ambiguous\nhas no notion of dispositions or a change manifest at all; never reads or writes anything but the lockfile itself\nshould reproduce the same hashes when run again against an unchanged codebase\nreturns the built lock data",
      "text_hash": "887be05cf438d4a355d80ee1a9e62f90c198118ee9896e005947ce046da1419e",
      "code_hash": "123fcc50c936501a05279d03403481f6078b6f4f7b501a2048c970d0bdc34068",
      "last_change": {
        "disposition": "flow_refs's return type changed from dict to (dict, list[errors]); build() now goes through a new private _flow_refs_or_raise() helper that unpacks it and still raises ValueError (refusing to write) if any flow call target is unresolved or ambiguous, preserving the original hard-refusal behavior for write operations.",
        "for_spec_hash": "887be05cf438d4a355d80ee1a9e62f90c198118ee9896e005947ce046da1419e",
        "for_code_hash": "123fcc50c936501a05279d03403481f6078b6f4f7b501a2048c970d0bdc34068"
      }
    },
    "llmlang.lockfile_builder.finalize": {
      "file": "llmlang/lockfile_builder.py",
      "text": "+ guards an incremental rebuild against silently skipping a flagged entry, reading and updating a change manifest bound to the exact spec and code hashes it describes\naccepts an llmlang file path, a lockfile output path, and a change manifest file path\nuses Checker to find every named entry and flow reference currently flagged against the existing lockfile, and refuses to write anything unless the change manifest covers every one of them with a non-empty disposition\nrefuses to write anything, same as build, when any internal flow call target is unresolved or ambiguous\naccepts a fresh disposition in the manifest as a plain string, and stamps it with the entry's current spec hash and code hash\nstamps fresh flow dispositions with the referenced entry's current spec hash, current code hash, and current flow reference hash\na spec hash combines the entry's own text with every policy currently covering it, so a disposition goes stale whether the entry's own text changed or an applicable policy did\nfor a manifest entry that's already stamped, keeps it only if all recorded hashes still match the entry or flow reference's current state; otherwise drops it as stale, along with any entry whose key no longer exists\naccepts a fresh one-time disposition for a removed flow reference, then prunes it from the lock and changes file\nbuilds every hash and disposition fresh from the current llmlang text, current code, current policies, and current manifest only; never carries anything forward from the lockfile's own prior content\nwrites both the new lockfile and the updated (stamped and pruned) manifest file, but never alters a disposition's own text\nreturns the built lock data",
      "text_hash": "d77ecfb10e323bb6064c7a16bcffdcb3ac8c13ab281a6e55347823cd3b124ade",
      "code_hash": "95b33e571741e6d311122102076e89888f67446842668f06d80d47598d357e00",
      "last_change": {
        "disposition": "same flow_refs signature change as build(): finalize() now calls _flow_refs_or_raise() too, so it still refuses to write over a broken flow reference rather than silently accepting it.",
        "for_spec_hash": "d77ecfb10e323bb6064c7a16bcffdcb3ac8c13ab281a6e55347823cd3b124ade",
        "for_code_hash": "95b33e571741e6d311122102076e89888f67446842668f06d80d47598d357e00"
      }
    },
    "llmlang.coverage_checker.check_coverage": {
      "file": "llmlang/coverage_checker.py",
      "text": "+ checks every module- and class-level Python function against comment handles and inline llm-exempt markers, reporting each uncovered one as UNMAPPED_CODE\naccepts an llmlang file path\nchecks every module- and class-level Python function against comment handles and inline llm-exempt markers, reporting each uncovered one as UNMAPPED_CODE\nonly checks files with a Python extension; files in other languages are silently skipped, not flagged\na function is covered if a comment handle sits on the line directly above it, or above its first decorator\na function nested inside another function is never checked on its own; it has no stable qualified name to report or exempt, and its enclosing function's own handle (if any) already sweeps its code into that handle's region\na function is exempt if a bare \"[llm-exempt]\" comment sits on the line directly above it, or above its first decorator - a reason may be written before the tag on the same line but isn't required, and there is no built-in exemption for dunder methods, private helpers, or anything else\nreturns the list of findings, each a Finding record",
      "text_hash": "fce995bc4afb7df1e534e3449ba1e5dddfa30bc6e66917a2869b74e7676f7cbc",
      "code_hash": "6f50f5b8a4bc58f99ac84ca6e6b9a992ae653c5db5f515164e565212f538fe76"
    },
    "llmlang.lockfile_checker.check": {
      "file": "llmlang/lockfile_checker.py",
      "text": "+ checks a lockfile by using Parser and Extractor to compare current text and code hashes against Lockfile, reporting each entry as SPEC_DIVERGED, CODE_DIVERGED, or unchanged, alongside its file and line\naccepts an llmlang file path and a lockfile path\nchecks a lockfile by using Parser and Extractor to compare current text and code hashes against Lockfile, reporting each entry as SPEC_DIVERGED, CODE_DIVERGED, or unchanged, alongside its file and line\nreports TEST_LINK_MISSING when any test bullet lacks a matching llm-test comment with the same text and canonical node name\nreports TEST_TRACE_STALE when any llm-test comment lacks a matching test bullet with the same text and canonical node name\nreports TEST_CODE_DIVERGED when a linked test's backing code hash differs from the lockfile\nreports FLOW_DIVERGED when an internal flow reference is new, removed, or stale against the referenced llmlang entry, backing code, or flow block text\nreports FLOW_ERROR, with the flow file and source line, when a flow call target is unresolved or ambiguous, without losing any other finding for the same file\nshould report an entry as SPEC_DIVERGED when its own llmlang text changed, it's brand new, or an upstream policy covering it changed\nshould report an entry as CODE_DIVERGED when its handle is missing from the code or its code changed unexpectedly\nshould report an unmodified codebase as fully clean\nnever prints anything itself; every finding is returned as a Finding record in a list, so a caller can present every failure from a run together instead of relying on interleaved prints, or render them as structured data instead of text\neach finding names a file and line where known: entry-level findings point at the entry's header line in the llmlang file, code-level findings point at the handle's own comment line in the source file\nreturns whether everything checked out clean, the set of named-entry and flow-reference tracking keys currently flagged for any reason, and the list of findings",
      "text_hash": "fe6250467c6033b06bdb6018fb46e0b8f1b4c85722996c466f7e45edc7435fee",
      "code_hash": "de1e89eb4672e22b1d22c8d47de8f37be9cd46b512afddea7e2f78fffd7206e4",
      "last_change": {
        "disposition": "check() now unpacks flow_refs()'s (refs, errors) return and converts each error into a real FLOW_ERROR Finding with file+line, instead of letting the underlying ValueError propagate and crash the report. This is the fix for the report-collapsing crash: a bad flow reference is now just one more finding alongside everything else, not a fatal exception.",
        "for_spec_hash": "fe6250467c6033b06bdb6018fb46e0b8f1b4c85722996c466f7e45edc7435fee",
        "for_code_hash": "de1e89eb4672e22b1d22c8d47de8f37be9cd46b512afddea7e2f78fffd7206e4"
      }
    },
    "llmlang.cli.find_pyproject": {
      "file": "llmlang/cli.py",
      "text": "+ finds the nearest pyproject.toml by walking up from a starting directory\naccepts a starting directory\nfinds the nearest pyproject.toml by walking up from a starting directory, all the way to the filesystem root\nreturns the first pyproject.toml found, or nothing",
      "text_hash": "b4fee237a6dfa2d1f35366284bc10c3f01c07f4b4b4cac307e6e011218d7bb19",
      "code_hash": "49a96116014d7a521d9449bc5e33c5da16876dbe4735a6bb812fa978d077eb17"
    },
    "llmlang.cli.load_config": {
      "file": "llmlang/cli.py",
      "text": "+ loads the [tool.llmlang] table from pyproject.toml, degrading gracefully when it can't be read\naccepts a starting directory and an optional explicit config path override\nloads the [tool.llmlang] table from pyproject.toml, degrading gracefully when it can't be read\nuses the override path directly when given, otherwise finds the nearest pyproject.toml from the starting directory\nwarns to stderr and returns an empty config, rather than crashing, when the override path doesn't exist or when this Python has no tomllib (needs 3.11+)\nreturns an empty config when no pyproject.toml is found at all\nreturns the [tool.llmlang] table",
      "text_hash": "9521deb303a7b48284dd128dc8d415298b2757ee22b4b542399d9dd7333cebe8",
      "code_hash": "eead4c5defe4756cf7edbb8e76631471c4dba01e7674e043861594c6ed0b2430"
    },
    "llmlang.cli.resolve_coverage": {
      "file": "llmlang/cli.py",
      "text": "+ decides whether --coverage is active, letting a CLI flag override the config either way\naccepts the parsed flags and the loaded config\ndecides whether --coverage is active, letting a CLI flag override the config either way\n--no-coverage always forces it off, then --coverage always forces it on, then the config's own coverage value is the default\nreturns whether coverage checking is active",
      "text_hash": "908c23420b23d97f16310ae384b4405e508da6e57d6cfe441cb99c98dd92a6b1",
      "code_hash": "afbd41ca3373ec7c9cfb5abfd1d8b1806c3a3f2a2602b9dd679c56a140139516"
    },
    "llmlang.cli.discover_llm_files": {
      "file": "llmlang/cli.py",
      "text": "+ finds every *.llm file under a directory, honoring the built-in and config-configured exclusions\naccepts a root directory and an extra set of directory names to exclude\nfinds every *.llm file under a directory, honoring the built-in and config-configured exclusions\nexcludes .git, __pycache__, node_modules, venv, and .venv by default, plus anything the config's exclude list adds\nreturns the sorted list of discovered files",
      "text_hash": "03612a38c9fe5f039b3bf015df81b76bfaa2356fd78c490458ec1a8e189797bf",
      "code_hash": "42e41f3981306840366d52afd7c74df6661231e5bb03cce58a5b7b85c5d3781a"
    },
    "llmlang.cli.check_one": {
      "file": "llmlang/cli.py",
      "text": "+ checks a single llmlang file, adding coverage findings when coverage is active\naccepts an llmlang file path and whether coverage checking is active\nchecks a single llmlang file, adding coverage findings when coverage is active\nif checking raises an error, reports it as a single ERROR finding instead of letting the exception propagate\nreturns whether it checked out clean and the combined list of findings",
      "text_hash": "aeaf0709ce0ae7d0b6909cb30dd4276fbeb08e1c203828dc87bbc6308c63fdf4",
      "code_hash": "e293003177cc9082719c4fbb4d4f41ad02e02f2b41ade4ce914dbf49d2c501db",
      "last_change": {
        "disposition": "defense in depth for the same crash class: check_one()'s except ValueError fallback used to return a list of bare strings, which both print_report_text and print_report_json assumed were Finding objects (crashing on .message / asdict()) - it now wraps the message in a real Finding(category=\"ERROR\", ...) so any future ValueError out of check() degrades to a normal reported finding instead of a crash.",
        "for_spec_hash": "aeaf0709ce0ae7d0b6909cb30dd4276fbeb08e1c203828dc87bbc6308c63fdf4",
        "for_code_hash": "e293003177cc9082719c4fbb4d4f41ad02e02f2b41ade4ce914dbf49d2c501db"
      }
    },
    "llmlang.cli.print_report_text": {
      "file": "llmlang/cli.py",
      "text": "+ prints every finding across every checked file in one delineated FAILURES section, or a bare OK line when nothing was flagged\naccepts every checked file's findings, keyed by file\nprints every finding across every checked file in one delineated FAILURES section, or a bare OK line when nothing was flagged\nreports the total failure and file count at the end, correctly pluralized",
      "text_hash": "8d86537d2968bdfd31a908c13767d42f42b42b6a8f84cbf1162bcd9f7ac85aff",
      "code_hash": "d7be1bc93658c964c4a2fb9945aeeb26bd445aa478354e4bf08e1f1f8c39a43b"
    },
    "llmlang.cli.print_report_json": {
      "file": "llmlang/cli.py",
      "text": "+ prints every finding as JSON, structured identically to what the text report renders from\naccepts every checked file's findings, keyed by file\nprints every finding as JSON, structured identically to what the text report renders from\nthe JSON shape is {\"ok\": bool, \"results\": {file: [{category, message, file, line}, ...]}}",
      "text_hash": "a2cc0ba041db817943474655a28f25c3ba5c3d607ae3d44570801cf66f8ffd55",
      "code_hash": "15c9add003438a83f16ca07265a23e9f8fcaabbd3014cbb2bacde624c87986bf"
    },
    "llmlang.cli.run_check": {
      "file": "llmlang/cli.py",
      "text": "+ checks every path given, applying config-resolved coverage and exclusions, and reports every failure together\naccepts a list of file or directory paths, the parsed flags, an optional config path override, and the output format\nchecks every path given, applying config-resolved coverage and exclusions, and reports every failure together\naccepts any number of file or directory paths, auto-discovering every *.llm file under a directory and checking a .llm file directly\nwarns to stderr and skips a path that doesn't exist, rather than failing the whole run\nexits with an error if no .llm files are found under any given path\nprints \"checking X\" progress and any warnings to stderr, so stdout stays clean for the report in either format\nexits 0 if every checked file was clean, 1 otherwise",
      "text_hash": "abc8a57646f8242cba719f6610569a55b6bfc7f99d30dec108b5e6361c00f3ab",
      "code_hash": "b9ddca013f67caa8582c768a4cb5db37069e3792041a245943b71e9e10ebfeb3"
    },
    "llmlang.cli.run_build": {
      "file": "llmlang/cli.py",
      "text": "+ builds a fresh lockfile for exactly one llmlang file, unguarded\naccepts a single llmlang file path\nbuilds a fresh lockfile for exactly one llmlang file, unguarded\nrefuses more than one file argument, since build is always scoped to one project\nexits 1 and prints the error on failure",
      "text_hash": "d89e9b1d2cccb3c678caf13b337dc9050d1d77ce8bf879e8dc4558447cc64d97",
      "code_hash": "918dc67e1b7d875a2d7251e5065e448e21cee8f97d301fd4106ad3ea5eec7ede"
    },
    "llmlang.cli.run_finalize": {
      "file": "llmlang/cli.py",
      "text": "+ finalizes exactly one llmlang file's lockfile and change manifest, guarded by Checker\naccepts a single llmlang file path\nfinalizes exactly one llmlang file's lockfile and change manifest, guarded by Checker\nrefuses more than one file argument, since finalize is always scoped to one project\nexits 1 and prints the error on failure",
      "text_hash": "a54850aa25fbf1aab18ba12688057413de4c7a9e3854d7518e534ea31c7d9a22",
      "code_hash": "e8dd6bca6270f057a55e1b5d22c7a51c4078eae2e7c5c7f6bcf0ece93e18288b"
    },
    "llmlang.cli.main": {
      "file": "llmlang/cli.py",
      "text": "+ parses argv into a command and validated flags, then dispatches to check, build, or finalize\naccepts no arguments; reads argv directly\nparses argv into a command and validated flags, then dispatches to check, build, or finalize\n--help or -h anywhere in argv, or no arguments at all, prints usage\n--version prints the installed package version, falling back to a bundled version string when llmlang isn't actually installed\nrejects a command outside {check, build, finalize}, and rejects any flag that isn't valid for the given command (--coverage on build, say, or --config on finalize) - nothing is silently ignored\n--config and --output-format each consume the next argument as their value",
      "text_hash": "7a38d673d1cc1f50ada5c46f3a6a434c50f4f986ab2656a8d2d2cff2569b5fc9",
      "code_hash": "16aa05d4a37c0918ff196505518d96256b12ab046eef83ddd0883e112cefa25c"
    }
  },
  "class_bullets": {},
