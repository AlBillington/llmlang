    "llmlang.cli.resolve_coverage": {
      "file": "llmlang/cli.py",
      "text": "+ decides whether --coverage is active, letting a CLI flag override the config either way\naccepts the parsed flags and the loaded config\ndecides whether --coverage is active, letting a CLI flag override the config either way\n--no-coverage always forces it off, then --coverage always forces it on, then the config's own coverage value is the default\nreturns whether coverage checking is active",
