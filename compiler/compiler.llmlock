{
  "lockfile_schema_version": 6,
  "ruleset_version": "2026-08-28-generated-flow-view",
  "policies": {},
  "entries": {
    "llmlang.lockfile.LockEntry": {
      "file": "llmlang/lockfile.py",
      "text": "+ stores, per source-handled entry, its file, text hash, and code hash\nstores, per source-handled entry, its file, text hash, and code hash\nmay also store a last-change disposition, bound to the entry's spec hash (its own text combined with every currently applicable policy's text) and code hash it was recorded against",
      "text_hash": "95f5b971fdc8b3d65888be804121d90e9437ec153f98bd013a71c009d5ce5c38",
      "code_hash": "8b6f67e1b5389c40fbd5ab5c7c7d712d2ed15763c3c573e79779623c7a80085e"
    },
    "llmlang.lockfile.TestTrace": {
      "file": "llmlang/lockfile.py",
      "text": "+ stores, per linked test comment, the explanation text and backing code hash\nstores, per linked test comment, the explanation text, relative path, and backing code hash",
      "text_hash": "92fb8019738001b932631290f55fe676729bd0d531afb6b9378dfe8b1734c9ef",
      "code_hash": "edd2e7db796eeea2c7699b48f12186b0afffb77f0da55d05d2a5b4e1231b59fb"
    },
    "llmlang.lockfile.Finding": {
      "file": "llmlang/lockfile.py",
      "text": "+ stores one check/coverage failure as structured data, not just display text\ncategory: text (\"CODE_DIVERGED\"): a fixed, stable identifier for the kind of failure, decoupled from the human-readable message's exact wording\nmessage: text (\"the code changed with no matching llmlang update - investigate before assuming it was intentional\"): the full human-readable explanation, identical to what was printed before this existed\nfile: text (\"legacy_app/notes.py\") or nothing: the file the failure is about, when known\nline: number (12) or nothing: the line within that file, when known",
      "text_hash": "1a1b6fb664f66c038a6013ef840c5774b1495b855e7df339b46c1ae9722c5e90",
      "code_hash": "927de630cc8f3b58e7cd7baf1577212d1ee00c4a185d803cfc745b2deab82a29"
    },
    "llmlang.lockfile.LOCKFILE_SCHEMA_VERSION": {
      "file": "llmlang/lockfile.py",
      "text": "+ the lockfile's own schema version, bumped whenever its shape changes\nthe lockfile's own schema version, bumped whenever its shape changes",
      "text_hash": "b9f92471aa22fd03ab91f3b557549276034892eb0e1f302621a907dde3363810",
      "code_hash": "086243d520d045cbfb2381028095e459f1fa159f37192c200869b0972d0fcd8d"
    },
    "llmlang.lockfile.RULESET_VERSION": {
      "file": "llmlang/lockfile.py",
      "text": "+ the ruleset version every entry in a lockfile is built under together\nthe ruleset version every entry in a lockfile is built under together",
      "text_hash": "e601f7998dd91fd4a4749025f2de0e57027e38c9c95c0c412f4fb5df430aacda",
      "code_hash": "5ea69529f87d23600fb27be40d16d38a750eecce157e46ba8ab96451ba61c6f3"
    },
    "llmlang.parser.parse": {
      "file": "llmlang/parser.py",
      "text": "+ parses a tab-indented llmlang file into a tree of folders, files, classes, and entries\naccepts a file path\nparses a tab-indented llmlang file into a tree of folders, files, classes, named entries, and data entries\na source-handled entry header must include a parenthesized summary after the identifier and before the colon\na data entry header must include the data marker after the identifier and before the parenthesized summary\na nested regular bullet belongs to the same nearest entry, file or class bullet group, or policy item as its parent\na test bullet can live under a named entry, file, or class node\na header's real name is always its first word; any words after a folder, file, or class name up to the colon are a freetext hint, discarded once the name is extracted\na bare `@entry-point` or `@entry-point(label)` line immediately before a named entry header marks that entry as a flow-generation starting point, rejecting it outright on any other kind of header\na `\u2192 call CanonicalName` or `\u2192 call operation via ExternalService` bullet, and an optional following `\u2190 return ...` bullet, are valid anywhere a regular bullet is valid, including nested under a decision, case, or repeat bullet\nrecords the source line number of each folder, file, class, named entry, and data entry header, and of each test bullet\nreturns the parsed tree",
      "text_hash": "50549f0e870f10af4ffba8cfccf115d97b9b2cb4d65ce6778ebf60f2e42d7a4a",
      "code_hash": "ae6f8882f17b128a636a8164e064da585701fba4ea6829a847228a4d5ffd042b"
    },
    "llmlang.extractor.TestComment": {
      "file": "llmlang/extractor.py",
      "text": "+ stores a linked llm-test comment and the backing code it anchors\nstores a linked llm-test comment's canonical node, explanation text, relative path, source line, and backing code\nexposes a code hash derived from the backing code",
      "text_hash": "20d5152dab70806917f28be31a0954855463ca98f78bef00159892c8c28c2ec5",
      "code_hash": "bb0d62379359f5992eef51dd16f666e25afdf22208176cc7add48059cd17aba4"
    },
    "llmlang.extractor.extract_by_handle": {
      "file": "llmlang/extractor.py",
      "text": "+ extracts the code implementing an entry by locating its comment handle and taking everything from the handle's own comment line up to the next handle\naccepts a file path and canonical entry name\nextracts the code implementing an entry by locating its comment handle and taking everything from the handle's own comment line up to the next handle\nincluding the comment line itself means the entry's summary comment is part of the resulting hash, so it can't drift from the llmlang summary undetected\nreturns the extracted code and the line number of its handle comment, or nothing if the handle isn't found",
      "text_hash": "8452197c555ea937c30520b03ce03b84a7bd8b0c2916b7b36517f2657cdc4f33",
      "code_hash": "dfcdba4cfc149411d59081171b439737e81d27a2a6de0cb8e103dbb1d36e12b8"
    },
    "llmlang.extractor.handle_line_numbers": {
      "file": "llmlang/extractor.py",
      "text": "+ finds the source line of every comment handle in a file, for coverage checking\naccepts a file path\nfinds the source line of every comment handle in a file, for coverage checking\nreturns the set of line numbers",
      "text_hash": "cfd49872979966b7290a3230865f3eb77ba8da0878632708786d170762be7514",
      "code_hash": "a8a0c66867dfcd947939f1fcb294d6dcf4c7ba9f023eee420eed15d64cb29162"
    },
    "llmlang.extractor.test_comment_roots": {
      "file": "llmlang/extractor.py",
      "text": "+ chooses where llm-test comments are scanned\naccepts an llmlang file path\nreturns the llmlang file directory and the repository tests directory when a repository root is found",
      "text_hash": "555eff9210bda9dbfdca0093fd62ad021685bc5bb139635b3e2759a17dbd05d1",
      "code_hash": "a5f8d3e17803833fdb889815cca435072ced6f724a6d9f7e84250b8ef53d28a6"
    },
    "llmlang.extractor.test_comment_base": {
      "file": "llmlang/extractor.py",
      "text": "+ chooses the stable base path for test trace paths\naccepts an llmlang file path\nreturns the repository root when one is found, otherwise the llmlang file directory",
      "text_hash": "036a14bad4f6f52675b6e1fd6f661121e5f761196c3f673ff68c3f2d1d18d7e1",
      "code_hash": "d793db1688af8a0ed0bb89e3a7ab548f643da46f32e700ade39ae1bd4c13cc40"
    },
    "llmlang.extractor.test_comments_by_node": {
      "file": "llmlang/extractor.py",
      "text": "+ collects llm-test comments by canonical node name\naccepts one or more root paths\nscans source-like text files under the root paths for llm-test handles\nrecords each llm-test comment's canonical node, exact explanation text, relative path, source line, and backing test code\nreturns a mapping of canonical node name to linked test comment records",
      "text_hash": "e95b81b2ad50c83236d2c2e96feae4996d51fb52766584b082adb91434adfb7f",
      "code_hash": "c261257f3b95803cb4f10ca2113cad3345e0d0fae2857f55dafa5118f38b5a10"
    },
    "llmlang.flow.generate_flow": {
      "file": "llmlang/flow.py",
      "text": "+ composes a .llmflow view by walking every @entry-point entry and inlining each \u2192 call target's own bullets, recursively, expanding each referenced entry only the first time it's reached in a given trace\naccepts the list of @entry-point entries and every named entry's own summary and bullets\ncomposes a .llmflow view by walking every @entry-point entry and inlining each \u2192 call target's own bullets, recursively\nexpands a referenced entry's own bullets only the first time it's reached in a given entry point's trace; a repeat reference (including a cycle) renders as a bare call line with nothing nested under it\nresolves a \u2192 call target to a known llmlang entry by exact canonical name or unique suffix match\ntreats a \u2192 call target containing \" via \" as an external call with nothing to resolve or expand\nrenders a plain \"returns ...\" bullet with a \u2190 marker instead of -, the same as an explicit \u2190 return line\nrenders a called entry's own trailing \"returns ...\"/\u2190 return bullet at the calling \u2192 call line's own depth, not nested inside the called entry's body, since it marks control coming back out to the caller's level\nreports each non-external \u2192 call target that doesn't resolve to exactly one entry as an error naming the entry it came from, rather than raising or losing any other output\nreturns the composed text for every entry point, and the list of any call-target errors found",
      "text_hash": "d0b02cd68c09da7f97dd9a6a1f597894e9233dc331ae16e0fe55f43043be879a",
      "code_hash": "0397dae0c714300c103c9cdb114e779ed7e6f3cf079528267f00c61ed6e0f9d7"
    },
    "llmlang.flow.generate_flow_for_tree": {
      "file": "llmlang/flow.py",
      "text": "+ builds the entry-point list and entry content from a parsed llmlang tree, then composes the flow view\naccepts a parsed llmlang tree\nbuilds the entry-point list and entry content from a parsed llmlang tree, then composes the flow view using generate_flow\nexcludes ~ test bullets from every entry's content; a flow view is about execution, not test coverage\nreturns the same (text, errors) shape as generate_flow",
      "text_hash": "735a922587f6115665cbe4b385dad3595159809a6a7975cdf23dd2ab0a378795",
      "code_hash": "2eb4849ff28584d38e49c1952304111530e2d4ef47e6329e185449e4acc8e6fe"
    },
    "llmlang.lockfile_builder.build": {
      "file": "llmlang/lockfile_builder.py",
      "text": "+ builds a lockfile by using Parser to read llmlang, Extractor to locate each entry's code, and Lockfile to record a text and code hash per entry\naccepts an llmlang file path and a lockfile output path\nbuilds a lockfile by using Parser to read llmlang, Extractor to locate each source-handled entry's code, and Lockfile to record a text and code hash per entry\nwrites test trace records with the llm-test explanation text, relative path, and backing code hash\ngenerates and overwrites the sibling .llmflow file from the current @entry-point entries and bullets\nchecks whether any test bullet lacks a matching llm-test comment or any llm-test comment lacks a matching test bullet:\n\t- if yes, refuses to write anything\nchecks whether any \u2192 call target in an @entry-point entry's reachable bullets is unresolved or ambiguous:\n\t- if yes, refuses to write anything\nhas no notion of dispositions or a change manifest at all; never reads or writes anything but the lockfile and the generated flow file\nreproduces the same hashes when run again against an unchanged codebase\nreturns the built lock data",
      "text_hash": "e08b5de976401e36a390f09fa1313c399886a8c6644f5e1a3848c0f5726aa055",
      "code_hash": "395647527734dee36d8b9e2922beaca0069d6e9019c1af8c7c093420569ff8dc"
    },
    "llmlang.lockfile_builder.finalize": {
      "file": "llmlang/lockfile_builder.py",
      "text": "+ guards an incremental rebuild against silently skipping a flagged entry, reading and updating a change manifest bound to the exact spec and code hashes it describes\naccepts an llmlang file path, a lockfile output path, and a change manifest file path\nuses Checker to find every named entry currently flagged against the existing lockfile, and refuses to write anything unless the change manifest covers every one of them with a non-empty disposition\nchecks whether any \u2192 call target in an @entry-point entry's reachable bullets is unresolved or ambiguous, same as build:\n\t- if yes, refuses to write anything\ngenerates and overwrites the sibling .llmflow file from the current @entry-point entries and bullets, same as build; a flow-only edit needs no disposition of its own, since it can only exist as part of an entry's own bullets, already gated by that entry's own SPEC_DIVERGED\naccepts a fresh disposition in the manifest as a plain string, and stamps it with the entry's current spec hash and code hash\na spec hash combines the entry's own text with every policy currently covering it, so a disposition goes stale whether the entry's own text changed or an applicable policy did\nfor a manifest entry that's already stamped, keeps it only if both hashes still match the entry's current state; otherwise drops it as stale, along with any entry whose key no longer exists\nbuilds every hash and disposition fresh from the current llmlang text, current code, current policies, and current manifest only; never carries anything forward from the lockfile's own prior content\nwrites both the new lockfile and the updated (stamped and pruned) manifest file, but never alters a disposition's own text\nreturns the built lock data",
      "text_hash": "e36cdc880fbb07f33e8b5c1a6515a51a4f98b9c46604577605e9ffc77bccce9e",
      "code_hash": "f581668bf2be64d6d75abcf5f3bcbdbc40c850950ce5c0c57926a45a604dfa65"
    },
    "llmlang.coverage_checker.check_coverage": {
      "file": "llmlang/coverage_checker.py",
      "text": "+ checks every module- and class-level Python function against comment handles and inline llm-exempt markers, reporting each uncovered one as UNMAPPED_CODE\naccepts an llmlang file path\nrepeats for each file the llmlang tree knows about:\n\t- checks whether the file has a Python extension:\n\t\t- if no, skips it, not flagged\n\t\t- if yes, continues processing\n\t- only considers functions defined at module or class level; a function nested inside another function is never checked on its own, since it has no stable qualified name to report or exempt, and its enclosing function's own handle (if any) already sweeps its code into that handle's region\n\t- repeats for each such function:\n\t\t- checks whether a comment handle, or a bare \"[llm-exempt]\" comment, sits on the line directly above it or above its first decorator (a reason may be written before the exempt tag on the same line but isn't required, and there is no built-in exemption for dunder methods, private helpers, or anything else):\n\t\t\t- if yes, continues to the next function\n\t\t\t- if no, reports it as UNMAPPED_CODE\nreturns the list of findings, each a Finding record",
      "text_hash": "6898f7570b70601175c758799e645c9de268797df4bae10eaab16afe962be11d",
      "code_hash": "6f50f5b8a4bc58f99ac84ca6e6b9a992ae653c5db5f515164e565212f538fe76",
      "last_change": {
        "disposition": "rewrote bullets from a rules/definitions style ('a function is covered if...', 'a function is exempt if...') into an execution-ordered checks-whether/repeats structure matching the real code's actual loop-and-branch shape (walk files, filter to .py, walk module/class-level functions, check handle-or-exempt, report UNMAPPED_CODE if neither). Same facts, verified against coverage_checker.py directly - no behavior changed. The old style read fine on its own in the .llm file, but reads out of place once inlined into a generated flow trace next to genuinely execution-ordered bullets, since it was never authored with that composition in mind.",
        "for_spec_hash": "6898f7570b70601175c758799e645c9de268797df4bae10eaab16afe962be11d",
        "for_code_hash": "6f50f5b8a4bc58f99ac84ca6e6b9a992ae653c5db5f515164e565212f538fe76"
      }
    },
    "llmlang.lockfile_checker.check": {
      "file": "llmlang/lockfile_checker.py",
      "text": "+ checks a lockfile by using Parser and Extractor to compare current text and code hashes against Lockfile, reporting each entry as SPEC_DIVERGED, CODE_DIVERGED, or unchanged, alongside its file and line\naccepts an llmlang file path and a lockfile path\nchecks a lockfile by using Parser and Extractor to compare current text and code hashes against Lockfile, reporting each entry as SPEC_DIVERGED, CODE_DIVERGED, or unchanged, alongside its file and line\nchecks whether any test bullet lacks a matching llm-test comment with the same text and canonical node name:\n\t- if yes, reports TEST_LINK_MISSING\nchecks whether any llm-test comment lacks a matching test bullet with the same text and canonical node name:\n\t- if yes, reports TEST_TRACE_STALE\nchecks whether a linked test's backing code hash differs from the lockfile:\n\t- if yes, reports TEST_CODE_DIVERGED\nchecks whether a \u2192 call target reachable from an @entry-point entry is unresolved or ambiguous:\n\t- if yes, reports FLOW_ERROR, naming the entry it came from, without losing any other finding for the same file\nchecks whether the checked-in .llmflow matches what generating one fresh from the current llmlang and code would produce:\n\t- if no, reports FLOW_FILE_STALE\nchecks whether an entry's own llmlang text changed, it's brand new, or an upstream policy covering it changed:\n\t- if yes, reports it as SPEC_DIVERGED\nchecks whether an entry's handle is missing from the code or its code changed unexpectedly:\n\t- if yes, reports it as CODE_DIVERGED\nreports a codebase with none of these changes as fully clean\nnever prints anything itself; every finding is returned as a Finding record in a list, so a caller can present every failure from a run together instead of relying on interleaved prints, or render them as structured data instead of text\neach finding names a file and line where known: entry-level findings point at the entry's header line in the llmlang file, code-level findings point at the handle's own comment line in the source file\nreturns whether everything checked out clean, the set of named-entry tracking keys currently flagged for any reason, and the list of findings",
      "text_hash": "010ba11dd12b03125e27934cac43df47a72bb414f5da16f9144799d8b3f31c35",
      "code_hash": "5ef6fee0620bf9f2d0c9fed5b57fd2ae0791b75dd8ce5880c88238852848bd7b"
    },
    "llmlang.cli.find_pyproject": {
      "file": "llmlang/cli.py",
      "text": "+ finds the nearest pyproject.toml by walking up from a starting directory\naccepts a starting directory\nfinds the nearest pyproject.toml by walking up from a starting directory, all the way to the filesystem root\nreturns the first pyproject.toml found, or nothing",
      "text_hash": "b4fee237a6dfa2d1f35366284bc10c3f01c07f4b4b4cac307e6e011218d7bb19",
      "code_hash": "49a96116014d7a521d9449bc5e33c5da16876dbe4735a6bb812fa978d077eb17"
    },
    "llmlang.cli.load_config": {
      "file": "llmlang/cli.py",
      "text": "+ loads the [tool.llmlang] table from pyproject.toml, degrading gracefully when it can't be read\naccepts a starting directory and an optional explicit config path override\nloads the [tool.llmlang] table from pyproject.toml, degrading gracefully when it can't be read\nchecks whether an override path was given:\n\t- if yes, uses it directly\n\t- if no, finds the nearest pyproject.toml from the starting directory\nchecks whether the override path doesn't exist, or this Python has no tomllib (needs 3.11+):\n\t- if yes, warns to stderr and returns an empty config, rather than crashing\nchecks whether no pyproject.toml was found at all:\n\t- if yes, falls back to an empty config, with no warning\nreturns the [tool.llmlang] table",
      "text_hash": "d399f53dd731a554b0a46ebf692b815249020b2bff74412ddc0c7d7508431593",
      "code_hash": "eead4c5defe4756cf7edbb8e76631471c4dba01e7674e043861594c6ed0b2430"
    },
    "llmlang.cli.resolve_coverage": {
      "file": "llmlang/cli.py",
      "text": "+ decides whether --coverage is active, letting a CLI flag override the config either way\naccepts the parsed flags and the loaded config\ndecides whether --coverage is active, letting a CLI flag override the config either way\n--no-coverage always forces it off, then --coverage always forces it on, then the config's own coverage value is the default\nreturns whether coverage checking is active",
      "text_hash": "908c23420b23d97f16310ae384b4405e508da6e57d6cfe441cb99c98dd92a6b1",
      "code_hash": "afbd41ca3373ec7c9cfb5abfd1d8b1806c3a3f2a2602b9dd679c56a140139516"
    },
    "llmlang.cli.discover_llm_files": {
      "file": "llmlang/cli.py",
      "text": "+ finds every *.llm file under a directory, honoring the built-in and config-configured exclusions\naccepts a root directory and an extra set of directory names to exclude\nfinds every *.llm file under a directory, honoring the built-in and config-configured exclusions\nexcludes .git, __pycache__, node_modules, venv, and .venv by default, plus anything the config's exclude list adds\nreturns the sorted list of discovered files",
      "text_hash": "03612a38c9fe5f039b3bf015df81b76bfaa2356fd78c490458ec1a8e189797bf",
      "code_hash": "42e41f3981306840366d52afd7c74df6661231e5bb03cce58a5b7b85c5d3781a"
    },
    "llmlang.cli.check_one": {
      "file": "llmlang/cli.py",
      "text": "+ checks a single llmlang file, adding coverage findings when coverage is active\naccepts an llmlang file path and whether coverage checking is active\n\u2192 call llmlang.lockfile_checker.check\nif checking raises an error, reports it as a single ERROR finding instead of letting the exception propagate\nchecks whether coverage checking is active:\n\t- if yes:\n\t\t\u2192 call llmlang.coverage_checker.check_coverage\n\t- if no, skips coverage checking\nreturns whether it checked out clean and the combined list of findings",
      "text_hash": "f0d5602275343980884f3652522db376a746e94ca37db1272b3f0d4c565d962e",
      "code_hash": "e293003177cc9082719c4fbb4d4f41ad02e02f2b41ade4ce914dbf49d2c501db"
    },
    "llmlang.cli.print_report_text": {
      "file": "llmlang/cli.py",
      "text": "+ prints every finding across every checked file in one delineated FAILURES section, or a bare OK line when nothing was flagged\naccepts every checked file's findings, keyed by file\nprints every finding across every checked file in one delineated FAILURES section, or a bare OK line when nothing was flagged\nreports the total failure and file count at the end, correctly pluralized",
      "text_hash": "8d86537d2968bdfd31a908c13767d42f42b42b6a8f84cbf1162bcd9f7ac85aff",
      "code_hash": "d7be1bc93658c964c4a2fb9945aeeb26bd445aa478354e4bf08e1f1f8c39a43b"
    },
    "llmlang.cli.print_report_json": {
      "file": "llmlang/cli.py",
      "text": "+ prints every finding as JSON, structured identically to what the text report renders from\naccepts every checked file's findings, keyed by file\nprints every finding as JSON, structured identically to what the text report renders from\nthe JSON shape is {\"ok\": bool, \"results\": {file: [{category, message, file, line}, ...]}}",
      "text_hash": "a2cc0ba041db817943474655a28f25c3ba5c3d607ae3d44570801cf66f8ffd55",
      "code_hash": "15c9add003438a83f16ca07265a23e9f8fcaabbd3014cbb2bacde624c87986bf"
    },
    "llmlang.cli.run_check": {
      "file": "llmlang/cli.py",
      "text": "+ checks every path given, applying config-resolved coverage and exclusions, and reports every failure together\naccepts a list of file or directory paths, the parsed flags, an optional config path override, and the output format\nchecks every path given, applying config-resolved coverage and exclusions, and reports every failure together\n\u2192 call llmlang.cli.load_config\n\u2192 call llmlang.cli.resolve_coverage\naccepts any number of file or directory paths, auto-discovering every *.llm file under a directory and checking a .llm file directly\n\u2192 call llmlang.cli.discover_llm_files\nwarns to stderr and skips a path that doesn't exist, rather than failing the whole run\nexits with an error if no .llm files are found under any given path\nrepeats checking for each discovered or directly given llmlang file:\n\t\u2192 call llmlang.cli.check_one\nprints \"checking X\" progress and any warnings to stderr, so stdout stays clean for the report in either format\nfor json case:\n\t\u2192 call llmlang.cli.print_report_json\nfor text case:\n\t\u2192 call llmlang.cli.print_report_text\nexits 0 if every checked file was clean, 1 otherwise",
      "text_hash": "8b8077e96d1f490963fe0b827a5d62a1470d9fe229529eb194f3896710eb5e0e",
      "code_hash": "b9ddca013f67caa8582c768a4cb5db37069e3792041a245943b71e9e10ebfeb3"
    },
    "llmlang.cli.run_build": {
      "file": "llmlang/cli.py",
      "text": "+ builds a fresh lockfile for exactly one llmlang file, unguarded\naccepts a single llmlang file path\nbuilds a fresh lockfile for exactly one llmlang file, unguarded\nrefuses more than one file argument, since build is always scoped to one project\n\u2192 call llmlang.lockfile_builder.build\nexits 1 and prints the error on failure",
      "text_hash": "47bdc138c70eb419fd2f14f1e8b3453c0e7d9dea7e0f29b6985376ba688d08e2",
      "code_hash": "918dc67e1b7d875a2d7251e5065e448e21cee8f97d301fd4106ad3ea5eec7ede"
    },
    "llmlang.cli.run_finalize": {
      "file": "llmlang/cli.py",
      "text": "+ finalizes exactly one llmlang file's lockfile and change manifest, guarded by Checker\naccepts a single llmlang file path\nfinalizes exactly one llmlang file's lockfile and change manifest, guarded by Checker\nrefuses more than one file argument, since finalize is always scoped to one project\n\u2192 call llmlang.lockfile_builder.finalize\nexits 1 and prints the error on failure",
      "text_hash": "264d53f3514c7cfcd5d92f497e5ef07b4cdb7c81eca64f0799737f02ae56b662",
      "code_hash": "e8dd6bca6270f057a55e1b5d22c7a51c4078eae2e7c5c7f6bcf0ece93e18288b"
    },
    "llmlang.cli.main": {
      "file": "llmlang/cli.py",
      "text": "+ parses argv into a command and validated flags, then dispatches to check, build, or finalize\naccepts no arguments; reads argv directly\nparses argv into a command and validated flags, then dispatches to check, build, or finalize\n--help or -h anywhere in argv, or no arguments at all, prints usage\n--version prints the installed package version, falling back to a bundled version string when llmlang isn't actually installed\nrejects a command outside {check, build, finalize}, and rejects any flag that isn't valid for the given command (--coverage on build, say, or --config on finalize) - nothing is silently ignored\n--config and --output-format each consume the next argument as their value\nfor check case:\n\t\u2192 call llmlang.cli.run_check\nfor build case:\n\t\u2192 call llmlang.cli.run_build\nfor finalize case:\n\t\u2192 call llmlang.cli.run_finalize",
      "text_hash": "c860d0c6119ee627350fd92bd101827b81657ed1f7c86f856ef71a8e8e167a72",
      "code_hash": "16aa05d4a37c0918ff196505518d96256b12ab046eef83ddd0883e112cefa25c"
    }
  },
