{
  "lockfile_schema_version": 2,
  "ruleset_version": "2026-08-15",
  "policies": {},
  "entries": {
    "Compiler.Lockfile.LockEntry": {
      "file": "Compiler/Lockfile.py",
      "text": "stores, per named entry, its file, text hash, and code hash\nmay also store a last-change disposition, bound to the exact text hash and code hash it was recorded against",
      "text_hash": "4a7dc3f80d93a4f6b272be28b481c84e81b097278b5cb0b4887b96c82d46f66b",
      "code_hash": "30f675d30ed4fd587c8d2cfe4c619f1824d8e8c92560d769aeb4c68d534b0103"
    },
    "Compiler.Lockfile.LOCKFILE_SCHEMA_VERSION": {
      "file": "Compiler/Lockfile.py",
      "text": "the lockfile's own schema version, bumped whenever its shape changes",
      "text_hash": "37cf82f74e5a9235ff583257db36ad64d39b6abed83850e38a317d6d84fdff65",
      "code_hash": "744ce12c9d346de3e3543611b0e266086170d1e65e105d4d4355d08936772dd0"
    },
    "Compiler.Lockfile.RULESET_VERSION": {
      "file": "Compiler/Lockfile.py",
      "text": "the ruleset version every entry in a lockfile is built under together",
      "text_hash": "a0bb4f90f8ca9fb01e11a110dd50429a2e6b1e9909f44bc491134e3d88f21bf0",
      "code_hash": "29f9757650925448b6bc5a66631455e62ba0b96aafbcb2a0bda535a77b7102b2"
    },
    "Compiler.Parser.parse": {
      "file": "Compiler/Parser.py",
      "text": "accepts a file path\nparses a tab-indented llmlang file into a tree of folders, files, classes, and named entries\na header's real name is always its first word; any words after it up to the colon are a freetext hint, discarded once the name is extracted\nreturns the parsed tree",
      "text_hash": "049ff1b7999911fc9b6c8aa142e09bd3eaaf88872178505fc9484d66b0f0227f",
      "code_hash": "b3c6927a3afdae45966ddb0b06e63b143a242dd0fbaa474799d4955e745d11cb"
    },
    "Compiler.Extractor.extract_by_handle": {
      "file": "Compiler/Extractor.py",
      "text": "accepts a file path and a handle key\nextracts the code implementing an entry by locating its comment handle and taking everything up to the next handle\nreturns the extracted code, or nothing if the handle isn't found",
      "text_hash": "f023dca0a6c5b547671fa2c7914e574835e8ae8e493ffd9f33931b763ee8507e",
      "code_hash": "fdda20927cdb707da06e1583397bd1a646472a33fc65b3e0b14a63f7ee375800"
    },
    "Compiler.LockfileBuilder.build": {
      "file": "Compiler/LockfileBuilder.py",
      "text": "accepts an llmlang file path and a lockfile output path\nbuilds a lockfile by using Parser to read llmlang, Extractor to locate each entry's code, and Lockfile to record a text and code hash per entry\nhas no notion of dispositions or a change manifest at all; never reads or writes anything but the lockfile itself\nshould reproduce the same hashes when run again against an unchanged codebase\nreturns the built lock data",
      "text_hash": "8514c410ce67ce7afab7e75a87d7853fe46395f62086f43fc39251807a9939e8",
      "code_hash": "0290c121b1ce2b7cdcb9dd6efa367d5e193867d7829ccd9397140981dd9a6029"
    },
    "Compiler.LockfileBuilder.finalize": {
      "file": "Compiler/LockfileBuilder.py",
      "text": "accepts an llmlang file path, a lockfile output path, and a change manifest file path\nuses Checker to find every named entry currently flagged against the existing lockfile, and refuses to write anything unless the change manifest covers every one of them with a non-empty disposition\naccepts a fresh disposition in the manifest as a plain string, and stamps it with the entry's current text hash and code hash\nfor a manifest entry that's already stamped, keeps it only if both hashes still match the entry's current state; otherwise drops it as stale, along with any entry whose key no longer exists in the llmlang tree at all\nbuilds every hash and disposition fresh from the current llmlang text, current code, and current manifest only; never carries anything forward from the lockfile's own prior content\nwrites both the new lockfile and the updated (stamped and pruned) manifest file, but never alters a disposition's own text\nreturns the built lock data",
      "text_hash": "4e06fe39902e9abc730da0b3c36abadd9cdb00fe678aa7e0ddb0e4bd28be8209",
      "code_hash": "f51316307ed87fe3d0eda21eb5a99d63323808eabc0649211cb389744ad9e7a1"
    },
    "Compiler.LockfileChecker.check": {
      "file": "Compiler/LockfileChecker.py",
      "text": "accepts an llmlang file path and a lockfile path\nchecks a lockfile by using Parser and Extractor to compare current text and code hashes against Lockfile, reporting each entry as dirty, missing or corrupt, or unchanged, alongside its file and comment handle\nshould report an entry as dirty when its llmlang text changed since the last build\nshould report an entry as missing or corrupt when its handle is missing from the code\nshould report an unmodified codebase as fully clean\nreturns whether everything checked out clean, and the set of named-entry tracking keys currently flagged for any reason",
      "text_hash": "db368441a30de6a4989726adc7a006b5212955bee037a6486c169cfc34a9dbdc",
      "code_hash": "076547706ce9aef4963fde515833badc9f0630e38d957110a297e5708c133dcf"
    }
  },
  "class_bullets": {}
}