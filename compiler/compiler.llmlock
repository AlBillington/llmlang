{
  "lockfile_schema_version": 4,
  "ruleset_version": "2026-08-20-hash-only-test-traces",
  "policies": {},
  "entries": {
    "llmlang.lockfile.LockEntry": {
      "file": "llmlang/lockfile.py",
      "text": "+ stores, per source-handled entry, its file, text hash, and code hash\nstores, per source-handled entry, its file, text hash, and code hash\nmay also store a last-change disposition, bound to the entry's spec hash (its own text combined with every currently applicable policy's text) and code hash it was recorded against",
      "text_hash": "95f5b971fdc8b3d65888be804121d90e9437ec153f98bd013a71c009d5ce5c38",
      "code_hash": "8b6f67e1b5389c40fbd5ab5c7c7d712d2ed15763c3c573e79779623c7a80085e",
      "last_change": {
        "disposition": "unrelated ripple: renamed the Compiler package to llmlang (matching standard Python packaging convention - the importable package now matches the pip distribution name), with each module file renamed to snake_case (Parser.py -> parser.py, LockfileBuilder.py -> lockfile_builder.py, etc.). Tracking key changed because it's built from the folder/file path; no behavior changed.",
        "for_spec_hash": "95f5b971fdc8b3d65888be804121d90e9437ec153f98bd013a71c009d5ce5c38",
        "for_code_hash": "8b6f67e1b5389c40fbd5ab5c7c7d712d2ed15763c3c573e79779623c7a80085e"
      }
    },
    "llmlang.lockfile.TestTrace": {
      "file": "llmlang/lockfile.py",
      "text": "+ stores, per linked test comment, the explanation text and backing code hash\nstores, per linked test comment, the explanation text, relative path, and backing code hash",
      "text_hash": "92fb8019738001b932631290f55fe676729bd0d531afb6b9378dfe8b1734c9ef",
      "code_hash": "edd2e7db796eeea2c7699b48f12186b0afffb77f0da55d05d2a5b4e1231b59fb",
      "last_change": {
