    "llmlang.cli.run_build": {
      "file": "llmlang/cli.py",
      "text": "+ builds a fresh lockfile for exactly one llmlang file, unguarded\naccepts a single llmlang file path\nbuilds a fresh lockfile for exactly one llmlang file, unguarded\nrefuses more than one file argument, since build is always scoped to one project\nexits 1 and prints the error on failure",
