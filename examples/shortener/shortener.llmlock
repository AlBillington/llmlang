    "Backend.UrlShortener._code_to_url": {
      "file": "Backend/UrlShortener.py",
      "text": "+ stores a mapping of short code to original URL\nmapping:\n\t- text (\"aB3xY9\"): lookup key is the short code\n\t- text (\"https://example.com/page\"): value is the original URL",
      "text_hash": "521370a90ce0812b9a1ad3004e5bff6cf49ef34c1e0a227df663f3d2f40a929c",
      "code_hash": "1a2fac1bfac6dd207f5f0e3a8571bf8eeba76f5654bed0eca1ab0b2fe7f45ea7",
      "last_change": {
        "disposition": "data bullets updated to the new type (example): description convention - purely a documentation/legibility change, adds concrete example values alongside the existing type annotations, no code change needed",
        "for_spec_hash": "9c013b8dfe7bd63474ad8ce847c4890b8dc223337606fd355b116478cd8eea8a",
        "for_code_hash": "1a2fac1bfac6dd207f5f0e3a8571bf8eeba76f5654bed0eca1ab0b2fe7f45ea7"
      }
    },
