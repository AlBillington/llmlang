        "for_code_hash": "3654c44419a515e0d8bdf58413f6ee4c39257d8c82f0dbdfda03a5b2960c98b8"
      }
    },
    "Backend.UrlShortener.get_url": {
      "file": "Backend/UrlShortener.py",
      "text": "+ looks up the original URL for a given short code\naccepts a short code\nreturns the original URL\n~ should return not found for an unknown short code",
      "text_hash": "43d1401e4d090f6e2b64ecf99b74366ebaf1c764810691855ff94b25206df93f",
