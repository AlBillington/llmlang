  "entries": {
    "Backend.UrlShortener.create_short_code": {
      "file": "Backend/UrlShortener.py",
      "text": "+ creates a unique short code for a given long URL, using CodeGenerator to generate the code\naccepts a long URL\ncreates a unique short code for a given long URL\nuses CodeGenerator to generate the code\ngenerated codes must be unique per URL\nreturns the short code\n~ should return the same code when called twice with the same URL\n~ should generate unique codes per URL",
      "text_hash": "2e72914c1a66e422b0f686efd13b032d8f1ed88c917ac277dbc5409726211c5f",
      "code_hash": "3654c44419a515e0d8bdf58413f6ee4c39257d8c82f0dbdfda03a5b2960c98b8",
      "last_change": {
        "disposition": "extract_by_handle now includes the handle comment line in code_hash (bug fix, closes a real gap where the source comment could drift from the llmlang summary undetected) - no actual code change",
        "for_spec_hash": "a61e7c53ce8dc3988e6b6a733ac8d82b144ef968340d2b23b4d36098ca3a3781",
        "for_code_hash": "3654c44419a515e0d8bdf58413f6ee4c39257d8c82f0dbdfda03a5b2960c98b8"
      }
    },
    "Backend.UrlShortener.get_url": {
      "file": "Backend/UrlShortener.py",
      "text": "+ looks up the original URL for a given short code\naccepts a short code\nlooks up the original URL for a given short code\nreturns the original URL\n~ should return not found for an unknown short code",
      "text_hash": "f6babee59b6fac478121285cf05e8421d133418468118affef3babb717d6435b",
