  "entries": {
    "Backend.UrlShortener.create_short_code": {
      "file": "Backend/UrlShortener.py",
      "text": "+ creates a unique short code for a given long URL, using CodeGenerator to generate the code\naccepts a long URL\n\u2192 call Backend.CodeGenerator.generate\n# generated codes must be unique per URL\nreturns the short code\n~ should return the same code when called twice with the same URL\n~ should generate unique codes per URL",
      "text_hash": "339e3bfddce4ec16593215589300564ee4c87e8a56a71d6e77c0f1628cef7f58",
      "code_hash": "3654c44419a515e0d8bdf58413f6ee4c39257d8c82f0dbdfda03a5b2960c98b8",
