  "entries": {
    "Backend.UrlShortener.create_short_code": {
      "file": "Backend/UrlShortener.py",
      "text": "+ creates a unique short code for a given long URL, using CodeGenerator to generate the code\naccepts a long URL\ncreates a unique short code for a given long URL\nuses CodeGenerator to generate the code\ngenerated codes must be unique per URL\nshould return the same code when called twice with the same URL\nreturns the short code",
      "text_hash": "d31b79c1ec1fcd61884ba6e3284c3ec5b8d18ed63eb9b06100099cdbcc2a800a",
      "code_hash": "eb4e6e3d930cb74fe2a2ccf9484376f17ab9be935c5a5b68d8e89dd70af984f6"
    },
    "Backend.UrlShortener.get_url": {
      "file": "Backend/UrlShortener.py",
      "text": "+ looks up the original URL for a given short code\naccepts a short code\nlooks up the original URL for a given short code\nshould return not found for an unknown short code\nreturns the original URL",
      "text_hash": "f7501b902034f889f0b62b97567a7982df461d7ef02d7efe26e18f98736aced4",
      "code_hash": "19aaf6589cd34a91b7f124a00b64cae2bf604e1c32209194831f01208699d5f2"
    },
    "Backend.UrlShortener._code_to_url": {
      "file": "Backend/UrlShortener.py",
      "text": "+ stores a mapping of short code to original URL\nstores a mapping of short code to original URL",
      "text_hash": "105bc0f1a42973d0b62abb29c4e87c7c594c355eb8c90fc374588bdab38492f7",
      "code_hash": "c686aaad70c0f9d353d5ba081bbbef76b87533d67023d16e12b7f3ea81167bec"
    },
    "Backend.CodeGenerator.generate": {
      "file": "Backend/CodeGenerator.py",
      "text": "+ generates a random 6-character alphanumeric code\ngenerates a random 6-character alphanumeric code\nreturns the generated code",
      "text_hash": "30faa392a3b9a3c086cfe209d58911954efe99b41719241587d3e74c24f4187b",
      "code_hash": "2da5c623d68900fc4d7b6965e05eb1a672b133a7a0dbd11a51adfe71e2fa493e"
    },
    "Frontend.ShortenerUI.form": {
      "file": "Frontend/ShortenerUI.html",
      "text": "+ shows a text input for a long URL and a submit button\nshows a text input for a long URL and a submit button",
      "text_hash": "d756a9c36e41c84e65a2ed67b1ac66ce5e417f3f8b12f991c2f4017feb3443f0",
      "code_hash": "3b4ecb545eeba731a7057cea51316a8c2bc18d79d8865f8529c128c02953ea15"
    },
    "Frontend.ShortenerUI.shortenUrl": {
      "file": "Frontend/ShortenerUI.html",
      "text": "+ uses UrlShortener to create a short code when submitted\naccepts the long URL\nuses UrlShortener to create a short code when submitted\nreturns the short code",
      "text_hash": "79d0b9e69ee3a278b8274d1c10eb997f213c0f424f6ae9383521e54b06d47da7",
      "code_hash": "7735859ca58fe3cf0127d58e1728e973264ae4156f26f08e81730b15fd4dbd2d"
    },
    "Frontend.ShortenerUI.renderShortUrl": {
      "file": "Frontend/ShortenerUI.html",
      "text": "+ displays the resulting short URL as a clickable link to the original URL\naccepts the short code\ndisplays the resulting short URL as a clickable link to the original URL",
      "text_hash": "5e421ec381d5f45333bfcd2a169f65ef202f6fa4edbb2fab4321a5504994a136",
      "code_hash": "c8da4ed45ba4f83c97fa98e8b2a0a95158c7b46a83df6545849db85d349bfc10"
    }
  },
  "class_bullets": {
    "Backend.UrlShortener": {
      "text": "should return the original URL for a code that was previously created",
      "text_hash": "ca2083b90ddc8cb096d98becf7e31b39e13f9f2bd6655ab2c0c0427fc65dccc9",
      "depends_on": [
        "Backend.UrlShortener.create_short_code",
        "Backend.UrlShortener.get_url",
        "Backend.UrlShortener._code_to_url"
      ]
    }
  }
}